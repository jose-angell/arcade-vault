# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxx

# Destinatario de los mensajes del formulario de contacto.
# Con onboarding@resend.dev, Resend solo entrega al correo de tu propia cuenta:
# usa ese correo hasta verificar un dominio.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Opcional. Este es el valor por defecto.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"

# Supabase: URL y publishable key del proyecto.
# Dónde obtenerlas: Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

SUPABASE_DB_PASSWORD=xxxxx